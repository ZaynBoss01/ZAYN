    createBubble = function(msg, targetPlayer)
        if not targetPlayer or not targetPlayer.Character then return end
        local cleanMsg = msg
        local repMatch, restMsg = msg:match("^↪️ %[Replying to (.-)%]\n(.*)")
        if repMatch then cleanMsg = restMsg end
        if tostring(cleanMsg):match("<Sticker%d+>") then cleanMsg = "[Sticker 🌸]" end
        
        pcall(function()
            if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
                TextChatService:DisplayBubble(targetPlayer.Character, cleanMsg)
            else
                game:GetService("Chat"):Chat(targetPlayer.Character.Head or targetPlayer.Character.PrimaryPart, cleanMsg, Enum.ChatColor.White)
            end
        end)
    end

    local function createRGBTitle(parent, titleData)
        local lbl = Instance.new("TextLabel", parent)
        lbl.BackgroundTransparency = 1; lbl.Text = "[" .. titleData.text .. "]"
        lbl.Font = Enum.Font.GothamBlack; lbl.Size = UDim2.new(0, 0, 0, 15); lbl.AutomaticSize = Enum.AutomaticSize.X; lbl.TextSize = 12; lbl.TextYAlignment = Enum.TextYAlignment.Top 
        lbl.TextColor3 = Color3.fromRGB(255, 255, 255) 
        local grad = Instance.new("UIGradient", lbl)
        task.spawn(function()
            while lbl and lbl.Parent do
                local t = tick() * 0.25; local colors = {}
                for i = 0, 6 do table.insert(colors, ColorSequenceKeypoint.new(i/6, Color3.fromHSV((t + (i/6)) % 1, 0.4, 1))) end
                pcall(function() grad.Color = ColorSequence.new(colors) end); task.wait(0.05)
            end
        end)
    end

    local function makeSwipeable(frame, senderName, messageText)
        local startPos = nil
        frame.Active = true
        frame.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then startPos = input.Position end end)
        frame.InputEnded:Connect(function(input)
            if startPos and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
                local delta = input.Position - startPos
                if math.abs(delta.X) > 30 and math.abs(delta.Y) < 30 then 
                    updateGlobalReplyState(senderName, messageText) 
                end
                startPos = nil
            end
        end)
    end

