                        end
                    end
                    
                    -- Hide from Default Chat
                    local props = Instance.new("TextChatMessageProperties")
                    props.Text = " " 
                    return props
                end
                return nil
            end
        end
    end)

    -- Legacy Chat System Hook (For non-TextChatService games)
    for _, p in ipairs(Players:GetPlayers()) do 
        p.Chatted:Connect(function(msg) 
            if p.UserId ~= LocalPlayer.UserId and msg:find("^zmsg:") then
                local actualMsg = msg:sub(6)
                addMessageToUI(p.UserId, p.DisplayName, actualMsg, false)
                task.spawn(function() createBubble(actualMsg, p) end)
            end
        end) 
    end
    Players.PlayerAdded:Connect(function(p) 
        p.Chatted:Connect(function(msg) 
            if p.UserId ~= LocalPlayer.UserId and msg:find("^zmsg:") then
                local actualMsg = msg:sub(6)
                addMessageToUI(p.UserId, p.DisplayName, actualMsg, false)
                task.spawn(function() createBubble(actualMsg, p) end)
            end
        end)
    end)

    -- Actions: Global Send
    inputBox.FocusLost:Connect(function(enter)
        if enter and inputBox.Text:match("%S") then 
            sendGlobalMsg(inputBox.Text)
            inputBox.Text = "" 
        end
    end)
    
    sendBtn.MouseButton1Click:Connect(function()
        if inputBox.Text:match("%S") then
            sendGlobalMsg(inputBox.Text)
            inputBox.Text = ""
            safeTween(sendBtn, {Size = UDim2.new(0, 30, 0, 30)}, 0.1); task.wait(0.1); safeTween(sendBtn, {Size = UDim2.new(0, 34, 0, 34)}, 0.1)
        end
    end)

    task.delay(1, function() 
        local titleData = getPlayerTitle(myUserId)
        local titleText = titleData and titleData.text or nil
        local joinText = titleText == "CREATOR" and "🌟 [CREATOR] " .. myName .. " HAS ARRIVED WITH A MASSIVE AURA! 🌟" or "✨ " .. myName .. " joined the server chat!"
        addMessageToUI("SYSTEM", "[SYSTEM]", joinText, false)
    end)

end)()
