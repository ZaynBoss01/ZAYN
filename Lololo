                if res.Success and res.Body ~= "null" then
                    local s, data = pcall(function() return HttpService:JSONDecode(res.Body) end)
                    if s and type(data) == "table" then
                        local sorted = {}
                        for k, v in pairs(data) do table.insert(sorted, {k=k, v=v}) end
                        table.sort(sorted, function(a, b) return a.v.timestamp < b.v.timestamp end)
                        for _, msgObj in ipairs(sorted) do
                            if msgObj.v.text:find("%[TARGET_MARK%]") or msgObj.v.text:find("%[TARGET_REMOVE%]") then continue end
                            local sName, sMsg, sUID, cleanName = parseMessage(msgObj.v.text)
                            if sName and sMsg then 
                                local isSys = (sName == "[SYSTEM]")
                                addMessageToChat(sName, sMsg, isSys, tonumber(sUID), "Clan") 
                            end
                        end
                    end
                end
            end)
        end
    end
    
