        bGlow.Color = Color3.fromRGB(255, 255, 255)
        bGlow.Thickness = 2.5
        bGlow.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        bGlow.Transparency = 0 
        local uig = Instance.new("UIGradient", bGlow)
        task.spawn(function()
            local spd = 0.35
            while targetCard and targetCard.Parent do
                local t = tick() * spd
                pcall(function() 
                    if isVip then
                        uig.Color = ColorSequence.new({
                            ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 215, 0)),
                            ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 255, 100)),
                            ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 215, 0))
                        })
                    else
                        uig.Color = ColorSequence.new({
                            ColorSequenceKeypoint.new(0, Color3.fromHSV(t%1, 1, 1)),
                            ColorSequenceKeypoint.new(1, Color3.fromHSV((t+0.5)%1, 1, 1))
                        })
                    end
                end)
                task.wait(0.04)
            end
        end)
    end

